# Copy this file to .env and fill in what you have. Only TELEGRAM_BOT_TOKEN is required.

# Telegram: message @BotFather, send /newbot, paste the token here
TELEGRAM_BOT_TOKEN=

# Shrinks all timers to 1 minute so the loop is visible on stage
DEMO_MODE=true

# Storage: leave as SQLite, or paste your SingleStore connection (MySQL protocol)
DATABASE_URL=sqlite:///momentum.db
# DATABASE_URL=mysql+pymysql://USER:PASSWORD@HOST:3306/momentum

# Arcee (OpenAI-compatible). Get a key at the Arcee platform, then run:
#   python -m momentum.check_llm      (lists your models and previews nudges)
# Arcee platform serves open models, e.g. deepseek/deepseek-v4.1-flash or zai-org/glm-5.3-flash (fast + cheap).
LLM_BASE_URL=https://api.arcee.ai/api/v1
LLM_API_KEY=
LLM_MODEL=deepseek/deepseek-v4.1-flash

# Superlinked task-specific model for classifying excuses (optional)
SUPERLINKED_URL=
SUPERLINKED_API_KEY=

# Cognee memory (optional; run `pip install cognee` first, it needs its own LLM key)
COGNEE_ENABLED=false

# Amplitude project API key (optional)
AMPLITUDE_API_KEY=

# Shared secret for POST /trigger (Guild cron or webhook sends it as X-Trigger-Token)
TRIGGER_TOKEN=change-me
